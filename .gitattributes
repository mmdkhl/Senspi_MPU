* text=auto

*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.mmd text eol=lf
# Shell scripts run on the Raspberry Pi: with CRLF, bash stops at the first
# "set -euo pipefail" ("set: pipefail\r: invalid option name").
*.sh text eol=lf

*.bat text eol=crlf
