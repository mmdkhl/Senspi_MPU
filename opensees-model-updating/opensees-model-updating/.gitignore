# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Packaging / build ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ── Installed / editable mode ────────────────────────────────────────────────
pip-wheel-metadata/
*.dist-info/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.DS_Store
.vscode/settings.json
*.swp
*.swo
Thumbs.db

# ── Runtime outputs (generated at run time — do not commit) ──────────────────
output/*.json
output/*.txt
output/*.out
output/*.npz
output/*.png
output/*.csv

# Keep the output directory itself (so the folder exists in a fresh clone)
!output/.gitkeep

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
*.tmp
