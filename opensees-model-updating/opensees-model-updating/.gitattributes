# Set default line endings for the whole repo
* text=auto

# Force LF for Python and text files (avoids CRLF issues on Windows)
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.sh        text eol=lf
*.out       text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf

# Binary files — do not touch line endings or attempt merging
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.npz   binary
*.npy   binary
*.pkl   binary
*.pyc   binary
*.pyd   binary
*.so    binary
*.dylib binary

# Diff drivers — makes GitHub diffs more readable
*.py    diff=python
*.md    diff=markdown

# Mark generated/vendored files so GitHub hides them from diffs
docs/legacy_monolith.py  linguist-generated=true linguist-language=Python
